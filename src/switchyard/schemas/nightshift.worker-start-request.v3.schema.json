{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:nightshift:worker-start-request:v3",
  "title":"Nightshift HOLDING worker start request V3",
  "$comment":"Structural validation is not dispatch admission. Runtime derives V3 from exact V2+profile+requirement, seals V3, then seals the dispatch over the V3 digest and validates the complete graph; work_attempt_id and dispatch_occurrence_id must differ.",
  "type":"object",
  "additionalProperties":false,
  "required":["schema","request_digest","predecessor_schema","predecessor_request_digest","predecessor_sha256","predecessor_encoding","predecessor_bytes_hex","packet_digest","profile_digest","run_id","work_item_id","attempt_id","work_attempt_id","dispatch_occurrence_id","adapter_id","adapter_version","adapter_protocol","worker_brief_digest","workspace_identity","provider_model_class","timeout_seconds","maximum_output_bytes","recursive_worker_swarms_forbidden","approval_policy","expected_receipt_schema","provider_id","model_id","model_class","selected_model_ordinal","provider_admission_adapter_protocol","provider_admission_binding_schema","provider_admission_evidence_schema","provider_admission_snapshot_schema","codex_owner_head","switchyard_owner_head","switchyard_schema_sha256","switchyard_deterministic_fixture_sha256","provider_execution_id","internal_provider_retry_count","semantic_retry","approval_response_authorized","authority_effect"],
  "properties":{
    "schema":{"const":"nightshift.worker-start-request/v3"},
    "request_digest":{"$ref":"#/$defs/digest"},
    "predecessor_schema":{"const":"nightshift.worker-start-request/v2"},
    "predecessor_request_digest":{"$ref":"#/$defs/digest"},
    "predecessor_sha256":{"$ref":"#/$defs/digest"},
    "predecessor_encoding":{"const":"hex"},
    "predecessor_bytes_hex":{"type":"string","minLength":2,"maxLength":131072,"pattern":"^(?:[0-9a-f]{2})+$"},
    "packet_digest":{"$ref":"#/$defs/digest"},
    "profile_digest":{"$ref":"#/$defs/digest"},
    "run_id":{"$ref":"#/$defs/id"},
    "work_item_id":{"$ref":"#/$defs/id"},
    "attempt_id":{"$ref":"#/$defs/id"},
    "work_attempt_id":{"$ref":"#/$defs/id"},
    "dispatch_occurrence_id":{"$ref":"#/$defs/id"},
    "adapter_id":{"$ref":"#/$defs/id"},
    "adapter_version":{"$ref":"#/$defs/id"},
    "adapter_protocol":{"enum":["switchyard.codex-app-server/v2","nightshift.holding-deterministic-provider-admission-evidence/v1","nightshift.holding-deterministic-provider-admission-evidence/v2"]},
    "worker_brief_digest":{"$ref":"#/$defs/digest"},
    "workspace_identity":{"$ref":"#/$defs/id"},
    "provider_model_class":{"$ref":"#/$defs/id"},
    "timeout_seconds":{"type":"integer","minimum":1,"maximum":86400},
    "maximum_output_bytes":{"type":"integer","minimum":1024,"maximum":16777216},
    "recursive_worker_swarms_forbidden":{"const":true},
    "approval_policy":{"const":"SURFACE_ONLY_NO_RESPONSE"},
    "expected_receipt_schema":{"const":"nightshift.worker-terminal-receipt/v1"},
    "provider_id":{"$ref":"#/$defs/id"},
    "model_id":{"$ref":"#/$defs/id"},
    "model_class":{"$ref":"#/$defs/id"},
    "selected_model_ordinal":{"type":"integer","minimum":0,"maximum":15},
    "provider_admission_adapter_protocol":{"enum":["switchyard.codex-app-server/v2","nightshift.holding-deterministic-provider-admission-evidence/v1","nightshift.holding-deterministic-provider-admission-evidence/v2"]},
    "provider_admission_binding_schema":{"enum":["switchyard.codex-provider-admission-binding/v1","nightshift.holding-deterministic-provider-admission-evidence/v1","nightshift.holding-deterministic-provider-admission-evidence/v2"]},
    "provider_admission_evidence_schema":{"enum":["switchyard.codex-provider-admission-evidence/v1","nightshift.holding-deterministic-provider-admission-evidence/v1","nightshift.holding-deterministic-provider-admission-evidence/v2"]},
    "provider_admission_snapshot_schema":{"enum":["switchyard.codex-provider-admission-snapshot/v1","nightshift.holding-deterministic-provider-admission-evidence/v1","nightshift.holding-deterministic-provider-admission-evidence/v2"]},
    "codex_owner_head":{"enum":["c36a8137638decf8b04a49611354a90f32c5a945","6893ae42233aa95b1c1623497405681d99a589da","97b0acd5ce2ccb3c87a763606696c35a450947f6"]},
    "switchyard_owner_head":{"type":"string","pattern":"^[0-9a-f]{40}$"},
    "switchyard_schema_sha256":{"enum":["sha256:131f1f6e0cf8cb0aea26ed225c584440c81ffedd443c68ace23adecbe493cf93","sha256:448c2535c9c9586754d222912bbc86bc09fadb3c98059dc134141aff08efb8ba","sha256:0e9c851cc9fad9538408ab44d84737d5f4d4d7ef39f2fd5db20c6f88fc7fbb9e","sha256:4e4eac904735c570f3fe7332765fffe4608cc3987fee9c1ef4b8db3ffdf03376","sha256:2bcf795c753a08d3c7e2ef8b521b44b155054fccbd50452662230d59ddd3f293"]},
    "switchyard_deterministic_fixture_sha256":{"const":"sha256:cafa673ac58f60029fd6c1de229b4f57d9f42ba918b7ecb2a3bfb20cb2b41a31"},
    "provider_execution_id":{"type":"null"},
    "internal_provider_retry_count":{"const":0},
    "semantic_retry":{"const":false},
    "approval_response_authorized":{"const":false},
    "authority_effect":{"const":"LOCAL_AGENT_COMPUTE_SCHEDULING_ONLY"}
  },
  "allOf":[
    {"oneOf":[
      {"properties":{
        "adapter_id":{"not":{"const":"nightshift:holding-pattern-deterministic-fake-adapter"}},
        "adapter_protocol":{"const":"switchyard.codex-app-server/v2"},
        "provider_admission_adapter_protocol":{"const":"switchyard.codex-app-server/v2"},
        "provider_admission_binding_schema":{"const":"switchyard.codex-provider-admission-binding/v1"},
        "provider_admission_evidence_schema":{"const":"switchyard.codex-provider-admission-evidence/v1"},
        "provider_admission_snapshot_schema":{"const":"switchyard.codex-provider-admission-snapshot/v1"}
      }},
      {"properties":{
        "adapter_id":{"const":"nightshift:holding-pattern-deterministic-fake-adapter"},
        "adapter_version":{"const":"v1"},
        "adapter_protocol":{"const":"nightshift.holding-deterministic-provider-admission-evidence/v1"},
        "provider_admission_adapter_protocol":{"const":"nightshift.holding-deterministic-provider-admission-evidence/v1"},
        "provider_admission_binding_schema":{"const":"nightshift.holding-deterministic-provider-admission-evidence/v1"},
        "provider_admission_evidence_schema":{"const":"nightshift.holding-deterministic-provider-admission-evidence/v1"},
        "provider_admission_snapshot_schema":{"const":"nightshift.holding-deterministic-provider-admission-evidence/v1"}
      }},
      {"properties":{
        "adapter_id":{"const":"nightshift:holding-pattern-deterministic-fake-adapter"},
        "adapter_version":{"const":"v2"},
        "adapter_protocol":{"const":"nightshift.holding-deterministic-provider-admission-evidence/v2"},
        "provider_admission_adapter_protocol":{"const":"nightshift.holding-deterministic-provider-admission-evidence/v2"},
        "provider_admission_binding_schema":{"const":"nightshift.holding-deterministic-provider-admission-evidence/v2"},
        "provider_admission_evidence_schema":{"const":"nightshift.holding-deterministic-provider-admission-evidence/v2"},
        "provider_admission_snapshot_schema":{"const":"nightshift.holding-deterministic-provider-admission-evidence/v2"}
      }}
    ]}
  ],
  "$defs":{
    "digest":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "id":{"type":"string","minLength":1,"maxLength":512,"pattern":"^[A-Za-z0-9._:/-]+$"}
  }
}
